# Optional. Copy to `.env.local` (git-ignored) to change settings on your own computer.
# On Netlify, set the same name under Site configuration > Environment variables.

# Address of the Lista backend. If unset, the original Render backend is used.
# Local backend:        EXPO_PUBLIC_API_URL=http://localhost:8000
# PythonAnywhere:       EXPO_PUBLIC_API_URL=https://yourname.pythonanywhere.com
EXPO_PUBLIC_API_URL=
